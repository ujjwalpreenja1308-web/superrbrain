# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI APIs
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Scraping
FIRECRAWL_API_KEY=
BRIGHTDATA_API_KEY=
APIFY_API_KEY=

# Trigger.dev
TRIGGER_SECRET_KEY=

# Upstash Workflow / QStash
QSTASH_URL=https://qstash-eu-central-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Dodo Payments
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
# Product IDs from Dodo dashboard (one per plan × billing period)
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_GROWTH_MONTHLY=
DODO_PRODUCT_PRO_MONTHLY=

# Backend
# In production, comma-separate multiple origins:
# FRONTEND_URL=https://auth.covable.app,https://home.covable.app
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
PORT=3001
# Optional comma-separated additions to the built-in superadmin allowlist
SUPERADMIN_EMAILS=

# Integrations
COMPOSIO_API_KEY=
# 32-byte hex string for AES-256-GCM publisher credential encryption
PUBLISHER_ENCRYPTION_KEY=

# Frontend (prefix with VITE_)
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias supported by the frontend auth client
VITE_SUPABASE_ANON_KEY=
# Home subdomain URL (used for post-auth redirects)
# Auth lives at covable.app/auth — no separate auth subdomain needed
VITE_HOME_URL=https://home.covable.app
# Dodo Payments product IDs (frontend — used to build checkout URLs)
VITE_DODO_PRODUCT_STARTER_MONTHLY=
VITE_DODO_PRODUCT_GROWTH_MONTHLY=
VITE_DODO_PRODUCT_PRO_MONTHLY=
